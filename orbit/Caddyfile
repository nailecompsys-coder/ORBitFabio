# ORBit — Docker Compose Caddy (mount: ./Caddyfile → /etc/caddy/Caddyfile).
# Auth and WebSocket paths pass through unchanged; /api/* strips /api for FastAPI.

trading.clermontitstore.com {
	encode gzip

	handle /auth/* {
		reverse_proxy api:8000
	}

	handle /ws/* {
		reverse_proxy api:8000
	}

	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		try_files {path} {path}/ /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}

	log {
		output stderr
		format json
	}
}
