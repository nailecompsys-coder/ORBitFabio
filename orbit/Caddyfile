trading.clermontitstore.com {
        encode gzip

        handle /auth/* {
                reverse_proxy api:8000
        }

        handle /ws/* {
                reverse_proxy api:8000
        }

        handle /bot/* {
                reverse_proxy api:8000
        }

        handle /api/* {
                uri strip_prefix /api
                reverse_proxy api:8000
        }

        handle /novnc/* {
                uri strip_prefix /novnc
                reverse_proxy ovtlyr-browser:6080
        }

        handle /websockify {
                reverse_proxy ovtlyr-browser:6080
        }

        handle {
                root * /srv
                @assets {
                        path *.html *.js *.css *.json
                }
                header @assets Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
                try_files {path} /index.html
                file_server
        }
}

:80 {
        encode gzip

        handle /auth/* {
                reverse_proxy api:8000
        }

        handle /ws/* {
                reverse_proxy api:8000
        }

        handle /bot/* {
                reverse_proxy api:8000
        }

        handle /api/* {
                uri strip_prefix /api
                reverse_proxy api:8000
        }

        handle {
                root * /srv
                @assets {
                        path *.html *.js *.css *.json
                }
                header @assets Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
                try_files {path} /index.html
                file_server
        }
}
