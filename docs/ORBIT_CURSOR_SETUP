    cat > /etc/systemd/system/opend-${USER}.service << EOF

[Unit]

Description=Moomoo OpenD - ${USER^}

After=network.target

StartLimitIntervalSec=0

[Service]

Type=simple

User=ubuntu

WorkingDirectory=/opt/orbit/opend/${USER}

ExecStart=/opt/orbit/opend/${USER}/OpenD -cfg_file=/opt/orbit/opend/${USER}/OpenD.xml

Restart=always

RestartSec=30

StandardOutput=append:/opt/orbit/logs/opend-${USER}.log

StandardError=append:/opt/orbit/logs/opend-${USER}.log

[Install]

WantedBy=multi-user.target

EOF

    echo "Created opend-${USER}.service (port ${PORT}, telnet ${TELNET})"

