PHASE 6 — DOCKER COMPOSE
Use Docker Compose to manage Postgres. OpenD and the FastAPI bot run as systemd services (not Docker) because OpenD needs persistent file access and the bot needs to survive without Docker overhead.

File: /opt/orbit/docker-compose.yml

version: '3.9'

services:

  postgres:

    image: postgres:16-alpine

    container_name: orbit-postgres

    restart: unless-stopped

    environment:

      POSTGRES_USER: orbit

      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}

      POSTGRES_DB: orbit

    volumes:

      - ./postgres/data:/var/lib/postgresql/data

    ports:

      - "127.0.0.1:5432:5432"

    healthcheck:

      test: ["CMD-SHELL", "pg_isready -U orbit"]

      interval: 10s

      timeout: 5s

      retries: 5

networks:

  default:

    name: orbit-network

