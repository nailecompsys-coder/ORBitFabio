PHASE 2 — TEARDOWN
Run each block. Confirm it completes before moving to the next.
Stop and disable all custom services
# Stop the trading bot if running

systemctl stop optionsbot 2>/dev/null

systemctl disable optionsbot 2>/dev/null

systemctl stop northstar 2>/dev/null

systemctl disable northstar 2>/dev/null

# Stop any OpenD instances

systemctl stop opend-clayton opend-don opend-chris 2>/dev/null

systemctl disable opend-clayton opend-don opend-chris 2>/dev/null

# Stop web servers

systemctl stop caddy 2>/dev/null

systemctl stop nginx 2>/dev/null

# Stop any existing API or app services

for svc in $(ls /etc/systemd/system/*.service 2>/dev/null); do

    name=$(basename $svc .service)

    case $name in

        caddy|nginx|ssh|cron|ufw|fail2ban|docker|postgresql)

            echo "Keeping system service: $name"

            ;;

        *)

            echo "Stopping: $name"

            systemctl stop $name 2>/dev/null

            systemctl disable $name 2>/dev/null

            ;;

    esac

done

systemctl daemon-reload
Remove old service files
# Remove custom service files (keep system ones)

rm -f /etc/systemd/system/opend-*.service

rm -f /etc/systemd/system/optionsbot*.service

rm -f /etc/systemd/system/northstar*.service

rm -f /etc/systemd/system/orbit*.service

systemctl daemon-reload
Stop and remove all Docker containers and images
# WARNING: This removes ALL containers, images, volumes on this server

# If there are other projects in Docker, stop here and list them first:

# docker ps -a && docker images

# Remove all containers

docker stop $(docker ps -aq) 2>/dev/null

docker rm $(docker ps -aq) 2>/dev/null

# Remove all images

docker rmi $(docker images -q) 2>/dev/null

# Remove all volumes EXCEPT any you want to keep

# List them first: docker volume ls

docker volume prune -f

# Remove all networks except defaults

docker network prune -f
Remove old application directories
# Check contents before removing

ls -la /opt/optionsbot 2>/dev/null

ls -la /opt/northstar 2>/dev/null

# Remove old app directories

rm -rf /opt/optionsbot

rm -rf /opt/northstar

# Remove old Caddy config

rm -f /etc/caddy/Caddyfile

# Remove old nginx configs (if any)

rm -f /etc/nginx/sites-enabled/trading*

rm -f /etc/nginx/sites-available/trading*

echo "Teardown complete"
Uninstall conflicting packages (if installed outside Docker)
# Remove system-level Postgres if installed (we will use Docker)

systemctl stop postgresql 2>/dev/null

apt-get remove --purge postgresql* -y 2>/dev/null

apt-get autoremove -y

# Remove system-level nginx if installed (Caddy replaces it)

systemctl stop nginx 2>/dev/null

apt-get remove --purge nginx* -y 2>/dev/null

apt-get autoremove -y

echo "Package cleanup complete"


